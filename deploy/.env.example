# Copy to deploy/.env on the server. Never commit the real file.

# ---- images (CI fills these with the ACR paths; local builds use the defaults) ----
API_IMAGE=registry.cn-hangzhou.aliyuncs.com/<namespace>/investagent-api:latest
WEB_IMAGE=registry.cn-hangzhou.aliyuncs.com/<namespace>/investagent-web:latest
WEB_PORT=80

# ---- postgres (business tables + LangGraph checkpoints) ----
POSTGRES_DB=investagent
POSTGRES_USER=investagent
POSTGRES_PASSWORD=change-me-strong-password

# ---- api ----
# openssl rand -base64 48
INVEST_JWT_SECRET=change-me-at-least-32-random-bytes
INVEST_JWT_TTL_HOURS=72
# Register your own account first, then set to false so strangers cannot use your DashScope quota.
INVEST_ALLOW_REGISTRATION=true
INVEST_MAX_CONCURRENT_RUNS=2
INVEST_LOG_LEVEL=info

# ---- model & data ----
DASHSCOPE_API_KEY=sk-your-dashscope-key
USE_REAL_DATA=true
PLANNER_OUTPUT_MODE=tool_calling

# ---- optional tracing ----
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=
